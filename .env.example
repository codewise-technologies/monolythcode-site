# Contact form delivery (set these in Vercel → Project → Settings → Environment Variables)
# Formspree (current): one variable. When set, the SMTP variables below are ignored.
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Alternative: any SMTP service, e.g. Resend (see README)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
# SMTP_FROM=website@monolythcode.com
# CONTACT_TO=you@monolythcode.com

# Bot protection: Cloudflare Turnstile (Cloudflare dashboard -> Turnstile -> Add widget)
VITE_TURNSTILE_SITE_KEY=your-site-key        # public; read at build time, so redeploy after setting
TURNSTILE_SECRET_KEY=your-secret-key         # private; checked by api/contact.js
